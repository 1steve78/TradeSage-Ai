# Authentication
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=30d

# External APIs
NVIDIA_API_KEY=your_nvidia_nim_api_key
FINNHUB_API_KEY=your_finnhub_api_key
SMARTAPI_API_KEY=your_smartapi_key
NEWS_API_KEY=your_news_api_key
