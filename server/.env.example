PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tradesage?retryWrites=true&w=majority

# Redis
REDIS_HOST=localhost
