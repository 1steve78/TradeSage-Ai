# Build stage
FROM node:22-alpine as build
WORKDIR /app
COPY client/package*.json ./
RUN npm ci
COPY client/ ./
RUN npm run build

# Production serve stage using Nginx
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
# Note: nginx configuration will be injected via volume mount in docker-compose
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
